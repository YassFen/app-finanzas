# Copia este archivo como .env.local y completa los valores.
# NINGUNA de estas variables debe llevar el prefijo NEXT_PUBLIC_ (todas son solo del servidor).

# Clave compartida para entrar a la app (usa una frase larga)
APP_PASSWORD=

# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# "secret key" (sb_secret_...) o, en proyectos antiguos, la "service_role key". Nunca la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# Solo en Vercel (opcional): protege /api/keepalive. Genera otro valor aleatorio.
CRON_SECRET=
